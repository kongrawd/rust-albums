# Copy to .env (git-ignored) and fill in. Used by compose.yaml.

# Sign-in credentials. AUTH_USER must not contain ":".
AUTH_USER=admin
AUTH_PASS=change-me

# Folder on this machine with your albums. It must contain the marker file
# (see the README quick start).
PHOTOS_DIR=/srv/photos

# Host names / IPs you'll browse to, for the self-signed certificate.
ALBUMS_TLS_NAMES=albums.local,192.168.1.20

# The published image. Which tag to use: CONTRIBUTING.md "Releases".
ALBUMS_IMAGE=ghcr.io/kongrawd/rust-albums:latest

# Optional.
# ALBUMS_PORT=8443
